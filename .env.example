# =============================================================================
# Marg MCP Self-Hosted — Environment Configuration
# =============================================================================
# Copy this file to .env to override defaults:
#   cp .env.example .env

# ---- Security & Secrets (Change in Production) ----
MARG_SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
MARG_ADMIN_TOKEN=change-me-admin-token
MARG_METRICS_TOKEN=change-me-metrics-token

# ---- Network Ports ----
MARG_HTTP_PORT=80
MARG_PORT=8000

# ---- Database (PostgreSQL) ----
POSTGRES_DB=marg
POSTGRES_USER=marg
POSTGRES_PASSWORD=change-me-postgres-password

# Optional: Remote PostgreSQL connection string (Neon / RDS / Supabase)
# If set, the built-in postgres container is bypassed.
# MARG_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# ---- AI Diagnostic Assistant (Optional) ----
# Enables automated AI root-cause analysis when an agent crashes.
# Provider: none | groq | openai | openai_compatible (e.g., Ollama)
DIAGNOSTIC_LLM_PROVIDER=none
DIAGNOSTIC_LLM_MODEL=llama-3.3-70b-versatile
DIAGNOSTIC_LLM_API_KEY=
DIAGNOSTIC_LLM_BASE_URL=
